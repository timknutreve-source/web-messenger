# Copy this file to .env and adjust values as needed.
# docker-compose.yml reads these to configure PostgreSQL and the backend.
# Do not commit your real .env file.

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mobile_messenger
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Backend
SERVER_PORT=8080

# JWT authentication - JWT_SECRET MUST be overridden with a long random value
# in any shared or production environment. Generate one with, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-please-override-via-JWT_SECRET-env-var-1234567890
JWT_EXPIRATION_MINUTES=1440

# Encryption - ENCRYPTION_MASTER_KEY MUST be a Base64-encoded 256-bit
# (32-byte) AES key, and MUST be overridden with a real random value in any
# shared or production environment (see the README's Security section).
# Generate one with:
#   openssl rand -base64 32
ENCRYPTION_MASTER_KEY=REPLACE_WITH_A_REAL_BASE64_ENCODED_32_BYTE_KEY

# File storage (profile avatars). In Docker this is fixed to /app/storage
# and backed by the profile_storage named volume (see docker-compose.yml) -
# this variable only matters when running the backend locally without Docker.
# STORAGE_ROOT_DIR=./data/storage

# Email (account verification + password reset)
# EMAIL_PROVIDER=log (default) logs the verification/reset link to the backend
# console instead of sending it - safe for local development/testing without
# real SMTP credentials. Set EMAIL_PROVIDER=smtp and fill in the SMTP_* values
# below to actually send email.
EMAIL_PROVIDER=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
# Most real providers require these; a local no-auth test relay may need both set to false.
SMTP_AUTH=true
SMTP_STARTTLS=true

# Base URL embedded in verification/reset email links. Defaults to the Flutter
# app's own custom URL scheme (mobilemessenger://) so links open directly in
# the app via Android deep linking - see README. Point this at a real HTTPS
# domain instead if/when the app also has one (e.g. for Android App Links).
FRONTEND_BASE_URL=mobilemessenger://
