<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all REST/WebSocket calls to the backend. Previously only
         declared in the debug/profile manifests (added there "for development"),
         which meant a release build had no network access at all on a real
         device - this app is a messenger, so that's not optional in any variant. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required to record voice messages. Requested at runtime (the OS
         permission dialog) via AudioRecorder.hasPermission() before any
         recording starts - declaring it here only makes the OS allow the
         app to ask; it does not grant it silently. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="mobile_messenger"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- The backend is reached over plain HTTP (a LAN/dev deployment, no
             TLS). Dart's own networking (Dio, Image.network - used for every
             REST/WebSocket call, images and audio) is unaffected by Android's
             cleartext policy, since it doesn't go through the platform's
             native network stack. video_player's ExoPlayer does go through
             that native stack, though, so without this flag Android silently
             blocks every video request on API 28+, which is what made video
             playback fail while everything else worked. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
